# ============================================================
# WDYDY Theme Environment Variables
# ============================================================
# Copy this file to .env.wdydyd and fill in your values.
# These settings activate and configure the "What Did You Do
# Yesterday" theme for this application.
# ============================================================

# Activate the wdydy theme
THEME_DEFAULT=wdydy

# Site branding
THEME_SITE_NAME="What Did You Do Yesterday - Transcript Search"
THEME_TAGLINE="Search the WDYDY podcast transcripts"
THEME_SEARCH_PLACEHOLDER="Search episodes..."
THEME_SHOW_EPISODE_TYPES=true
THEME_DEFAULT_VIEW=transcripts

# SEO metadata
THEME_SEO_HOME_TITLE="What Did You Do Yesterday - Search Transcripts"
THEME_SEO_HOME_DESCRIPTION="Search transcripts from the What Did You Do Yesterday podcast. Find exactly what was said and when."
THEME_SEO_SEARCH_TITLE="{query} - WDYDY Search"
THEME_SEO_EPISODE_TITLE="{title} - What Did You Do Yesterday"

# Theme color overrides (optional - leave blank to use theme CSS defaults)
THEME_COLOR_PRIMARY=
THEME_COLOR_SECONDARY=
THEME_COLOR_ACCENT=
THEME_HEADER_GRADIENT_FROM=
THEME_HEADER_GRADIENT_TO=

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Queue configuration for long-running transcription jobs
DB_QUEUE_RETRY_AFTER=4200

OPENAI_API_KEY=some-key-here
SHARED_UPLOAD_SECRET=here-are-some-words

# Whisper Configuration
WHISPER_PYTHON_PATH=
WHISPER_SCRIPT_PATH=
WHISPER_BIN_PATH=
WHISPER_MODEL_PATH=
WHISPER_MODEL=large-v3-turbo

# Podcast Configuration
# Configure these for your podcast. See .env.wdydy for an example.
PODCAST_DEFAULT_RSS_URL=
PODCAST_NAME="My Podcast"
PODCAST_HOSTS=
PODCAST_TRANSCRIPTION_CONTEXT="This is a podcast transcription. Please maintain proper capitalization, punctuation, and formatting."

# Theme Configuration
# Available themes: 'base', 'wdydy'
THEME_DEFAULT=base
THEME_SITE_NAME="Podcast Search"
THEME_TAGLINE="Search your favorite podcast transcripts"
THEME_SEARCH_PLACEHOLDER="Search episodes..."

# Optional: Custom colors (hex values)
# THEME_COLOR_PRIMARY=#3b82f6
# THEME_COLOR_SECONDARY=#6366f1
# THEME_HEADER_GRADIENT_FROM=#3b82f6
# THEME_HEADER_GRADIENT_TO=#6366f1

# SEO Configuration
# THEME_SEO_HOME_TITLE="Podcast Search"
# THEME_SEO_HOME_DESCRIPTION="Search podcast episodes by transcript content."
